# ==============================================================================
# BOROOM YITTÉ YU KAWÉ YI — Environment Configuration Template
# Copy to `.env` for backend/Edge Functions and `mobile/.env.json` for Flutter
# NEVER commit real secrets or service role keys.
# ==============================================================================

# --- Supabase (Public client credentials - safe for mobile --dart-define) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Supabase Server-Only Credentials (Edge Functions / Admin scripts ONLY) ---
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- AI Gateway (Server-Side ONLY - never embed in Flutter binary) ---
AI_DEFAULT_PROVIDER=gemini
AI_DEFAULT_MODEL_GEMINI=gemini-2.5-flash
AI_DEFAULT_MODEL_OPENAI=gpt-4o-mini
AI_DEFAULT_MODEL_ANTHROPIC=claude-sonnet-4-20250514
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
AI_DAILY_USER_QUOTA_TOKENS=50000
AI_MONTHLY_BUDGET_USD=100

# --- Speech-to-Text (Server-Side ONLY) ---
STT_DEFAULT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
OPENAI_WHISPER_API_KEY=
GOOGLE_STT_API_KEY=

# --- LiveKit WebRTC Voice Rooms ---
LIVEKIT_URL=wss://YOUR_LIVEKIT_HOST.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Push Notifications (FCM / APNs) ---
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.boroomyitte.app

# --- Deep Linking & App URLs ---
APP_SCHEME=boroomyitte
APP_WEB_ORIGIN=https://app.boroomyitte.org
