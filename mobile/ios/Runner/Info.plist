	<string>Boroom Yitté utilise le microphone pour les débats vocaux Face-à-Face, l'entraînement en anglais, les simulations d'entretien et les salons vocaux communautaires (uniquement avec votre consentement explicite).</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
